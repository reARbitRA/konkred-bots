###############################################################################
# Konkred multi-bot AI ecosystem - environment template
#
#   cp .env.example .env   then fill in what you have.
#
# NOTHING here is mandatory to boot: with zero keys the gateway answers from its
# built-in deterministic mock provider, and only the bots whose token you set
# will start. Add providers incrementally.
###############################################################################

# =============================================================================
# 1. TELEGRAM BOT TOKENS   (get them from @BotFather)
# -----------------------------------------------------------------------------
# Set only the ones you want to run. Empty token = that bot stays offline.
# =============================================================================

# 🎙 Voice-to-Action: transcription, summary, action items
TELEGRAM_VOICE_BOT_TOKEN=

# 📄 Deep Document Assistant: summaries, quizzes, flashcards, risk analysis
TELEGRAM_PDF_BOT_TOKEN=

# 🎓 IELTS Speaking Coach: 3-part mock interview with band scoring
TELEGRAM_IELTS_BOT_TOKEN=

# 🎬 Viral Hook Architect: hooks, beat-by-beat scripts, SEO captions
TELEGRAM_CONTENT_BOT_TOKEN=

# 📊 Alpha Scanner: market sentiment, drivers, risk
TELEGRAM_CRYPTO_BOT_TOKEN=


# =============================================================================
# 2. GATEWAY SECURITY
# =============================================================================

# Unlocks GET /api/admin/dashboard, GET /api/admin/stats and POST /api/admin/reset.
# Compared with crypto.timingSafeEqual. Leave empty to disable the admin surface
# entirely. Generate one with:  openssl rand -hex 32
ADMIN_KEY=

# Shared secret the bots present to the gateway as `Authorization: Bearer ...`.
# Optional when both run on the private compose network; required if you expose
# the gateway publicly. Generate with:  openssl rand -hex 32
GATEWAY_API_KEY=

# Per-user overrides for the fair-use limiter, as JSON.
# tier: "free" | "pro" | "unlimited", or explicit rpm/rpd/tpd numbers.
#   {"123456789":{"tier":"pro"},"987654321":{"rpm":60,"rpd":5000}}
USERS_JSON=


# =============================================================================
# 3. AI PROVIDER CREDENTIALS   (all free tiers - add whichever you have)
# -----------------------------------------------------------------------------
# More providers = more total daily quota and better fallback depth.
# The gateway pools every key it finds and routes per task type.
# =============================================================================

# --- Google AI Studio (Gemini) -----------------------------------------------
# https://aistudio.google.com/apikey
# The ONLY provider with native audio + PDF understanding, so the voice and
# document bots depend on it for their best results. Free tier resets at
# midnight Pacific. Up to three keys are pooled for 3x the daily quota.
GEMINI_KEY_P1=
GEMINI_KEY_P2=
GEMINI_KEY_P3=

# --- Groq (fastest inference) ------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Cerebras (very fast, generous free tier) --------------------------------
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# --- Mistral La Plateforme ---------------------------------------------------
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- OpenRouter (aggregator, free model tier) --------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Cloudflare Workers AI ---------------------------------------------------
# https://dash.cloudflare.com/profile/api-tokens  (needs the Workers AI scope)
# BOTH values are required for this provider to activate.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- GitHub Models -----------------------------------------------------------
# https://github.com/settings/tokens  (a classic PAT with the models:read scope)
GITHUB_TOKEN=


# =============================================================================
# 4. RUNTIME TUNING   (safe defaults - override only if you need to)
# =============================================================================

# --- Service wiring ----------------------------------------------------------
# Host port the gateway is published on (container port is always 3000).
GATEWAY_PORT=3000
# Used by the bots inside the compose network. The unified root Dockerfile
# overrides this to loopback because both runtimes share one container.
GATEWAY_URL=http://gateway:3000
# Hosted deployments: paste the TLS URL from Upstash (rediss://default:...@...).
REDIS_URL=redis://redis:6379/0

# polling = local Compose / Hugging Face Space; webhook = Render web service.
BOT_MODE=polling
# Public Python health/webhook listener. Render supplies PORT automatically;
# Hugging Face Docker Spaces expects 7860.
WEB_HOST=0.0.0.0
PORT=7860
# Required only in webhook mode. Render provides RENDER_EXTERNAL_URL, so
# WEBHOOK_HOST can stay blank there. Generate the secret with `openssl rand -hex 32`.
WEBHOOK_HOST=
WEBHOOK_SECRET=

# debug | info | warn | error   (Python side accepts DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=info

# --- Response cache ----------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=500

# --- In-flight deduplication -------------------------------------------------
DEDUP_ENABLED=true
DEDUP_TTL_MS=180000

# --- Per-user fair use -------------------------------------------------------
USER_RPM=12
USER_RPD=400
USER_TPD=900000
PRO_USER_RPM=40
PRO_USER_RPD=3000
PRO_USER_TPD=6000000

# --- Quota safety headroom (fraction of each published limit) ----------------
# The pool refuses to exceed these, leaving margin for clock skew and
# concurrent instances. Lower them if you share keys with another application.
HEADROOM_RPM=0.85
HEADROOM_TPM=0.90
HEADROOM_RPD=0.95
HEADROOM_TPD=0.98

# --- Fallback behaviour ------------------------------------------------------
MAX_FALLBACK_ATTEMPTS=6
UPSTREAM_TIMEOUT_MS=90000
REQUEST_TIMEOUT_MS=120000
# Answer from the built-in mock provider when every real slot is exhausted.
ALLOW_MOCK=true
# Force mock-only (no outbound calls at all) - used by CI and offline demos.
MOCK_ONLY=false
# Multi-model consensus for /scan and /sentiment.
FUSION_ENABLED=true

# --- Watchdog ----------------------------------------------------------------
WATCHDOG_INTERVAL_MS=60000
WATCHDOG_CALIBRATION=true

# --- Advanced overrides (rarely needed) --------------------------------------
# Disable a provider without deleting its key. Default: enabled whenever a
# credential is present.
#   GEMINI_ENABLED=false
#   GROQ_ENABLED=false
#   CEREBRAS_ENABLED=false
#   MISTRAL_ENABLED=false
#   OPENROUTER_ENABLED=false
#   CLOUDFLARE_ENABLED=false
#   GITHUB_MODELS_ENABLED=false
#
# Point a provider at a proxy or a self-hosted compatible endpoint:
#   GEMINI_BASE_URL / GROQ_BASE_URL / CEREBRAS_BASE_URL / MISTRAL_BASE_URL
#   OPENROUTER_BASE_URL / CF_BASE_URL / GITHUB_MODELS_BASE_URL
#
# OpenRouter asks callers to identify themselves for free-tier attribution:
#   OPENROUTER_REFERER=https://github.com/reARbitRA/konkred-bots
#   OPENROUTER_TITLE=Konkred
#
# Gateway server internals:
#   HOST=0.0.0.0                 bind address (set to 0.0.0.0 in Docker)
#   PORT=3000                    in-container listen port
#   NODE_ENV=production
#   SERVICE_NAME=konkred-gateway
#   MAX_BODY_BYTES=8388608       hard cap on the POST /api/ai body
#   (the 2,000,000-character cap on total prompt text is a fixed constant in
#    src/gateway/gateway.mjs and is deliberately not configurable)
#   DASHBOARD_ENABLED=true       serve /api/admin/dashboard (needs ADMIN_KEY)
#   POLICY_REGISTRY_PATH=./data/policies.registry.json
#   WATCHDOG_STATE_PATH=./data/runtime.state.json
#   DOTENV_PATH=/path/to/.env    load an env file from a non-default location
#
# Bot-side HTTP client:
#   GATEWAY_TIMEOUT=120          seconds before the bots give up on a request
#   GATEWAY_MAX_RETRIES=2        retries for retryable gateway failures
#   GATEWAY_REQUIRE_AUTH=false   reject unauthenticated callers even with no key

# --- Monetization ------------------------------------------------------------
# Each user gets this many AI-powered actions in EACH bot before seeing an
# invoice. /start, help, document upload and other non-AI navigation stay free.
PAYMENTS_ENABLED=true
FREE_REQUESTS=5
# Telegram Stars price (XTR) and pass lifetime. Digital-goods Stars invoices do
# not need a provider token; Telegram confirms them directly to the bot.
STARS_PRICE=100
PAID_ACCESS_DAYS=30
# Signs invoice payloads. Generate with: openssl rand -hex 32
# If blank, WEBHOOK_SECRET (or the bot token) is used instead.
PAYMENT_SECRET=

# Optional USDT fallback. Keep this blank for digital access sold inside
# Telegram unless platform/legal guidance confirms a compliant use case;
# Telegram currently requires Stars for in-bot digital goods and services.
# USDT is manually approved because an address alone cannot prove payment.
USDT_WALLET_ADDRESS=
USDT_NETWORK=TRC20
USDT_PRICE=2.99
# Telegram numeric user ids allowed to approve USDT, comma/space separated.
PAYMENT_ADMIN_IDS=
# Public support handle shown on payment failures, e.g. @yourusername.
PAYMENT_SUPPORT=

# --- Telegram ----------------------------------------------------------------
# Largest file the bots will download from Telegram (Bot API caps this at 20 MB).
MAX_FILE_MB=20
# Conversation turns retained per user per bot, and their Redis TTL in seconds.
HISTORY_TURNS=10
HISTORY_TTL=86400
# Polling: ignore old queued updates on boot. In webhook mode use false so an
# update that wakes a sleeping free web service is not discarded.
DROP_PENDING_UPDATES=true
