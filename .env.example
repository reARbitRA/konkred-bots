###############################################################################
# Konkred multi-bot AI ecosystem - environment template
#
#   cp .env.example .env   then fill in what you have.
#
# NOTHING here is mandatory to boot: with zero keys the gateway answers from its
# built-in deterministic mock provider, and only the bots whose token you set
# will start. Add providers incrementally.
###############################################################################

# =============================================================================
# 1. TELEGRAM BOT TOKENS   (get them from @BotFather)
# -----------------------------------------------------------------------------
# Set only the ones you want to run. Empty token = that bot stays offline.
# =============================================================================

# 🎙 Voice-to-Action: transcription, summary, action items
TELEGRAM_VOICE_BOT_TOKEN=

# 📄 Deep Document Assistant: summaries, quizzes, flashcards, risk analysis
TELEGRAM_PDF_BOT_TOKEN=

# 🎓 IELTS Speaking Coach: 3-part mock interview with band scoring
TELEGRAM_IELTS_BOT_TOKEN=

# 🎬 Viral Hook Architect: hooks, beat-by-beat scripts, SEO captions
TELEGRAM_CONTENT_BOT_TOKEN=

# 📊 Alpha Scanner: market sentiment, drivers, risk
TELEGRAM_CRYPTO_BOT_TOKEN=


# =============================================================================
# 2. GATEWAY SECURITY
# =============================================================================

# Unlocks GET /api/admin/dashboard, GET /api/admin/stats and POST /api/admin/reset.
# Compared with crypto.timingSafeEqual. Leave empty to disable the admin surface
# entirely. Generate one with:  openssl rand -hex 32
ADMIN_KEY=

# Shared secret the bots present to the gateway as `Authorization: Bearer ...`.
# Optional when both run on the private compose network; required if you expose
# the gateway publicly. Generate with:  openssl rand -hex 32
GATEWAY_API_KEY=

# Per-user overrides for the fair-use limiter, as JSON.
# tier: "free" | "pro" | "unlimited", or explicit rpm/rpd/tpd numbers.
#   {"123456789":{"tier":"pro"},"987654321":{"rpm":60,"rpd":5000}}
USERS_JSON=


# =============================================================================
# 3. AI PROVIDER CREDENTIALS   (all free tiers - add whichever you have)
# -----------------------------------------------------------------------------
# More providers = more total daily quota and better fallback depth.
# The gateway pools every key it finds and routes per task type.
# =============================================================================

# --- Google AI Studio (Gemini) -----------------------------------------------
# https://aistudio.google.com/apikey
# The ONLY provider with native audio + PDF understanding, so the voice and
# document bots depend on it for their best results. Free tier resets at
# midnight Pacific. Up to three keys are pooled for 3x the daily quota.
GEMINI_KEY_P1=
GEMINI_KEY_P2=
GEMINI_KEY_P3=

# --- Groq (fastest inference) ------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Cerebras (very fast, generous free tier) --------------------------------
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# --- Mistral La Plateforme ---------------------------------------------------
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- OpenRouter (aggregator, free model tier) --------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Cloudflare Workers AI ---------------------------------------------------
# https://dash.cloudflare.com/profile/api-tokens  (needs the Workers AI scope)
# BOTH values are required for this provider to activate.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- GitHub Models -----------------------------------------------------------
# https://github.com/settings/tokens  (a classic PAT with the models:read scope)
GITHUB_TOKEN=


# =============================================================================
# 4. RUNTIME TUNING   (safe defaults - override only if you need to)
# =============================================================================

# --- Service wiring ----------------------------------------------------------
# Host port the gateway is published on (container port is always 3000).
GATEWAY_PORT=3000
# Used by the bots inside the compose network. Change only outside Docker.
GATEWAY_URL=http://gateway:3000
REDIS_URL=redis://redis:6379/0

# debug | info | warn | error   (Python side accepts DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=info

# --- Response cache ----------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=500

# --- In-flight deduplication -------------------------------------------------
DEDUP_ENABLED=true
DEDUP_TTL_MS=180000

# --- Per-user fair use -------------------------------------------------------
USER_RPM=12
USER_RPD=400
USER_TPD=900000
PRO_USER_RPM=40
PRO_USER_RPD=3000
PRO_USER_TPD=6000000

# --- Quota safety headroom (fraction of each published limit) ----------------
# The pool refuses to exceed these, leaving margin for clock skew and
# concurrent instances. Lower them if you share keys with another application.
HEADROOM_RPM=0.85
HEADROOM_TPM=0.90
HEADROOM_RPD=0.95
HEADROOM_TPD=0.98

# --- Fallback behaviour ------------------------------------------------------
MAX_FALLBACK_ATTEMPTS=6
UPSTREAM_TIMEOUT_MS=90000
REQUEST_TIMEOUT_MS=120000
# Answer from the built-in mock provider when every real slot is exhausted.
ALLOW_MOCK=true
# Force mock-only (no outbound calls at all) - used by CI and offline demos.
MOCK_ONLY=false
# Multi-model consensus for /scan and /sentiment.
FUSION_ENABLED=true

# --- Watchdog ----------------------------------------------------------------
WATCHDOG_INTERVAL_MS=60000
WATCHDOG_CALIBRATION=true

# --- Telegram ----------------------------------------------------------------
# Largest file the bots will download from Telegram (Bot API caps this at 20 MB).
MAX_FILE_MB=20
# Conversation turns retained per user per bot, and their Redis TTL in seconds.
HISTORY_TURNS=10
HISTORY_TTL=86400
# Ignore updates that queued up while the daemon was down.
DROP_PENDING_UPDATES=true
