# Keep the build context small and never bake secrets or caches into a layer.

# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Node --------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# --- Runtime state (regenerated by the watchdog on boot) ---------------------
data/runtime.state.json

# --- Tests (not needed in the runtime image) ---------------------------------
test/
coverage/

# --- VCS / editors / OS ------------------------------------------------------
.git/
.gitignore
.vscode/
.idea/
.DS_Store
*.swp

# --- Logs --------------------------------------------------------------------
*.log
logs/
tmp/
