{
  "version": "2026.09.1",
  "updatedAt": "2026-09-19",
  "notes": "Quota registry for the Konkred AI Gateway. Every entry describes one logical model slot: the upstream provider id, the upstream model name, the free-tier quota envelope and the capability surface used by the router. Numbers reflect published free-tier allowances; the watchdog self-calibrates them downward when the upstream disagrees.",
  "defaults": {
    "resetTimezone": "UTC",
    "maxOutputTokens": 4096,
    "capabilities": [
      "text"
    ],
    "latencyClass": "standard",
    "qualityScore": 0.5
  },
  "providers": {
    "gemini": {
      "label": "Google AI Studio (Gemini)",
      "resetTimezone": "America/Los_Angeles",
      "credentialEnv": [
        "GEMINI_KEY_P1",
        "GEMINI_KEY_P2",
        "GEMINI_KEY_P3"
      ],
      "docs": "https://ai.google.dev/gemini-api/docs/rate-limits"
    },
    "groq": {
      "label": "Groq Cloud",
      "resetTimezone": "UTC",
      "credentialEnv": [
        "GROQ_API_KEY"
      ],
      "docs": "https://console.groq.com/docs/rate-limits"
    },
    "cerebras": {
      "label": "Cerebras Inference",
      "resetTimezone": "UTC",
      "credentialEnv": [
        "CEREBRAS_API_KEY"
      ],
      "docs": "https://inference-docs.cerebras.ai/support/rate-limits"
    },
    "mistral": {
      "label": "Mistral La Plateforme",
      "resetTimezone": "UTC",
      "credentialEnv": [
        "MISTRAL_API_KEY"
      ],
      "docs": "https://docs.mistral.ai/deployment/laplateforme/tier/"
