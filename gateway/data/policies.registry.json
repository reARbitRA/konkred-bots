    "openrouter": {
      "label": "OpenRouter",
      "resetTimezone": "UTC",
      "credentialEnv": [
        "OPENROUTER_API_KEY"
      ],
      "docs": "https://openrouter.ai/docs/api-reference/limits"
    },
    "cloudflare": {
      "label": "Cloudflare Workers AI",
      "resetTimezone": "UTC",
      "credentialEnv": [
        "CF_API_TOKEN"
      ],
      "docs": "https://developers.cloudflare.com/workers-ai/platform/limits/"
    },
    "github": {
      "label": "GitHub Models",
      "resetTimezone": "UTC",
      "credentialEnv": [
        "GITHUB_TOKEN"
      ],
      "docs": "https://docs.github.com/en/github-models/prototyping-with-ai-models"
    },
    "mock": {
      "label": "Built-in deterministic mock",
      "resetTimezone": "UTC",
      "credentialEnv": [],
      "docs": "local"
    }
